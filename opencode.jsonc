{
  // Schema for OpenCode configuration
  "$schema": "https://opencode.ai/config.json",

  // Username for the OpenCode instance
  "username": "Sebastian",

  // Enable automatic updates
  "autoupdate": true,

  // Allow all actions without prompts
  "permission": "allow",

  // Dissable Providers
  "disabled_providers": [],

  // Provider model filters - hide duplicates from opencode (Zen) that exist in opencode-go
  "provider": {
    "opencode": {
      "blacklist": [
        "minimax-m2.5",
        "minimax-m2.7",
        "glm-5",
        "glm-5.1",
        "kimi-k2.5",
        "kimi-k2.6",
        "qwen3.5-plus",
        "qwen3.6-plus",
      ],
    },
  },

  // Plugins to load
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "superpowers@git+https://github.com/obra/superpowers.git",
  ],

  // Agent-specific model configuration
  "agent": {
    // Built-in agents with specific models and colors
    "explore": {
      "model": "opencode-go/minimax-m2.5",
    },
    "general": {
      "model": "opencode-go/qwen3.5-plus",
    },
    "build": {
      "model": "opencode-go/qwen3.6-plus",
      "color": "secondary",
    },
    "plan": {
      "model": "opencode/claude-sonnet-4-6",
      "color": "accent",
    },
    // Custom agents with specific models and colors
    "x--free": {
      "model": "opencode/big-pickle",
      "color": "#ffc777",
      "description": "[   -|Free|-   ] Free tier model for unlimited experimentation",
      "mode": "primary",
    },
    "x-teach": {
      "model": "opencode/gemini-3-flash",
      "color": "#4fd6be",
      "description": "[󰫣   |   |󱐋󱐋󱐋 ] Learning companion — doesn't code, teaches concepts and how to find answers independently",
    },
    "z-forge": {
      "model": "opencode-go/mimo-v2.5-pro",
      "color": "#7086b5",
      "description": "[󰫣󰫣  | |󱐋   ] High-precision implementation specialist",
      "permission": {
        "skill": { "*": "ask" },
      },
    },
    "z-logic": {
      "model": "opencode-go/glm-5.1",
      "color": "#ff757f",
      "description": "[󰫣󰫣  | |󱐋   ] Reasoning architect for decomposition and design decisions",
      "permission": {
        "skill": { "*": "ask" },
      },
    },
    "z-nexus": {
      "model": "opencode-go/kimi-k2.6",
      "color": "#86e1fc",
      "description": "[󰫣󰫣  | |󱐋   ] Large-context analyzer for multi-file understanding",
      "permission": {
        "skill": { "*": "ask" },
      },
    },
    "z-pilot": {
      "model": "opencode/gpt-5.4",
      "color": "#82aaff",
      "description": "[󰫣󰫣  |  |󱐋󱐋  ] Tool and execution specialist for tests/builds/scripts",
      "permission": {
        "skill": { "*": "ask" },
      },
    },
    "z-spark": {
      "model": "opencode/deepseek-v4-flash-free",
      "color": "#c8d3f5",
      "description": "[   -|Free|-   ] Low-latency agent for quick tasks",
      "permission": {
        "skill": { "*": "ask" },
      },
    },
    "z-ultra": {
      "model": "opencode/gpt-5.5",
      "color": "#2e7de9",
      "description": "[󰫣󰫣󰫣 | |󱐋󱐋  ] Heavy refactor and structural transformation specialist",
      "permission": {
        "skill": { "*": "ask" },
      },
    },
  },

  // Commands
  "command": {
    "audit-agents": {
      "template": "Run the agent-model-audit skill to audit and optimize agent model assignments. Check if the user provided a priority mode argument: 'skill'/'ability'/'habilidad' (default) = role fit first; 'price'/'cost'/'precio'/'barato' = cost first; 'speed'/'fast'/'velocidad'/'rapido' = speed first. Use that mode throughout the optimization step. If no argument was given, default to 'skill' mode.",
      "description": "Audit and optimize agent model assignments. Optional argument: skill (default), price, or speed",
    },
    "sync-agents": {
      "template": "Run the agent-sync-neovim skill to synchronize agent definition changes across opencode.jsonc, agents/*.md, opencode_nvim_mcps.jsonc, and the neovim config directory at ~/.config/nvim/lua/utils/opencode-neovim/. Check for consistency in model assignments, agent name references, and skill permissions.",
      "description": "Sync agent changes across all config files and neovim directory",
    },
  },

  // MCP servers configuration
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true,
    },
    "augment-context-engine": {
      "type": "local",
      "command": ["auggie", "--mcp", "--mcp-auto-workspace"],
      "enabled": true,
    },
    // Neovim MCP server for buffer access and editing (bigcodegen)
    "neovim": {
      "type": "local",
      "command": ["npx", "-y", "mcp-neovim-server"],
      "enabled": false,
      "environment": {
        // Enable shell commands execution through vim
        "ALLOW_SHELL_COMMANDS": "true",
        // Socket path for neovim connection (uses NVIM env var)
        "NVIM_SOCKET_PATH": "{env:NVIM}",
      },
    },
  },
}
