{
  // Schema for OpenCode configuration
  "$schema": "https://opencode.ai/config.json",

  // Username for the OpenCode instance
  "username": "Sebastian",

  // Enable automatic updates
  "autoupdate": true,

  // Allow all actions without prompts
  "permission": "allow",

  // Dissable Providers
  "disabled_providers": [],

  // Provider model filters - hide duplicates from opencode (Zen) that exist in opencode-go
  "provider": {
    "opencode": {
      "blacklist": [
        "minimax-m2.5",
        "minimax-m2.7",
        "glm-5",
        "glm-5.1",
        "kimi-k2.5",
        "kimi-k2.6",
        "qwen3.5-plus",
        "qwen3.6-plus",
      ],
    },
  },

  // Plugins to load
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "superpowers@git+https://github.com/obra/superpowers.git",
  ],

  // Agent-specific model configuration
  "agent": {
    // Built-in agents with specific models and colors
    "build": {
      "model": "opencode-go/qwen3.6-plus",
      "color": "secondary",
      "description": "[$$  | !! ] Default agent for general coding and building tasks",
    },
    "plan": {
      "model": "opencode-go/glm-5.1",
      "color": "accent",
      "description": "[$$$ | !  ] Strategic planner for architecture and implementation plans",
    },
    "explore": {
      "model": "opencode-go/minimax-m2.5",
      "description": "[$   | !!!] Fast codebase exploration and information gathering",
    },
    "general": {
      "model": "opencode-go/qwen3.5-plus",
      "description": "[$   | !!!] General-purpose assistant for everyday tasks",
    },
    // Custom agents with specific models and colors
    "z-logic": {
      "model": "opencode-go/deepseek-v4-pro",
      "color": "#7AA2F7",
      "description": "[$$  | !! ] Reasoning architect for decomposition and design decisions",
      "permission": {
        "skill": { "*": "ask" },
      },
    },
    "z-forge": {
      "model": "opencode-go/mimo-v2.5-pro",
      "color": "#9ECE6A",
      "description": "[$$$ | !  ] High-precision implementation specialist",
      "permission": {
        "skill": { "*": "ask" },
      },
    },
    "z-nexus": {
      "model": "opencode-go/kimi-k2.6",
      "color": "#73DACA",
      "description": "[$$$ | !  ] Large-context analyzer for multi-file understanding",
      "permission": {
        "skill": { "*": "ask" },
      },
    },
    "z-ultra": {
      "model": "opencode-go/minimax-m2.7",
      "color": "#F7768E",
      "description": "[$$  | !!!] Heavy refactor and structural transformation specialist",
      "permission": {
        "skill": { "*": "ask" },
      },
    },
    "z-pilot": {
      "model": "opencode-go/glm-5",
      "color": "#7DCFFF",
      "description": "[$$$ | !  ] Tool and execution specialist for tests/builds/scripts",
      "permission": {
        "skill": { "*": "ask" },
      },
    },
    "z-spark": {
      "model": "opencode-go/deepseek-v4-flash",
      "color": "#C0CAF5",
      "description": "[$   | !!!] Low-latency agent for quick tasks",
      "permission": {
        "skill": { "*": "ask" },
      },
    },
    "free": {
      "model": "opencode/big-pickle",
      "color": "#BBAA33",
      "description": "[Free| ???] Free tier model for unlimited experimentation",
    },
  },

  // Commands
  "command": {
    "audit-agents": {
      "template": "Run the agent-model-audit skill to review all connected providers, analyze model cost and speed, check for duplicate model assignments, create an audit report in docs/agent-audits/YYYY-MM-DD.md, and update agent configurations with optimized model assignments and [cost | speed] indicators in descriptions.",
      "description": "Audit and optimize agent model assignments",
    },
  },

  // MCP servers configuration
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true,
    },
    "augment-context-engine": {
      "type": "local",
      "command": ["auggie", "--mcp", "--mcp-auto-workspace"],
      "enabled": true,
    },
    // Neovim MCP server for buffer access and editing (bigcodegen)
    "neovim": {
      "type": "local",
      "command": ["npx", "-y", "mcp-neovim-server"],
      "enabled": false,
      "environment": {
        // Enable shell commands execution through vim
        "ALLOW_SHELL_COMMANDS": "true",
        // Socket path for neovim connection (uses NVIM env var)
        "NVIM_SOCKET_PATH": "{env:NVIM}",
      },
    },
  },
}
